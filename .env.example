# Copia para .env e ajusta antes de publicares.

# Ligacao ao MongoDB. Local: mongodb://localhost:27017/portfolio
MONGODB_URI=mongodb://localhost:27017/portfolio

# Origens autorizadas a chamar a API, separadas por virgula.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Segredo de assinatura dos tokens. Minimo 32 bytes.
# Gera um: openssl rand -base64 48
JWT_SECRET=troca-este-segredo-em-producao-com-pelo-menos-32-bytes
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14

# Utilizador ADMIN criado no primeiro arranque.
ADMIN_EMAIL=manuelluvuvamo337@gmail.com
ADMIN_PASSWORD=troca-esta-password
ADMIN_NAME=Manuel Luvuvamo

# Popula as coleccoes vazias com o conteudo de seed/portfolio-seed.json.
SEED_ENABLED=true
