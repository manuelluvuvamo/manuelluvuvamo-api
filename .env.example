# Copia para .env e ajusta antes de publicares.

# Ligacao ao MongoDB. Local: mongodb://localhost:27017/portfolio
MONGODB_URI=mongodb://localhost:27017/portfolio

# Origens autorizadas a chamar a API, separadas por virgula.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Segredo de assinatura dos tokens. Minimo 32 bytes.
# Gera um: openssl rand -base64 48
JWT_SECRET=troca-este-segredo-em-producao-com-pelo-menos-32-bytes
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14

# Utilizador ADMIN criado no primeiro arranque.
ADMIN_EMAIL=manuelluvuvamo337@gmail.com
ADMIN_PASSWORD=troca-esta-password
ADMIN_NAME=Manuel Luvuvamo

# Popula as coleccoes vazias com o conteudo de seed/portfolio-seed.json.
SEED_ENABLED=true


# --- Nao e lido pela aplicacao ---------------------------------------------
#
# Endereco do health check do servico publicado, usado pelo workflow
# .github/workflows/manter-api-acordada.yml para manter a API acordada nas
# horas de maior trafego (o plano gratuito do Render adormece ao fim de ~15
# minutos sem pedidos).
#
# Nao ponhas isto num .env: o workflow corre no GitHub, nao aqui. Define-o em
#   Settings > Secrets and variables > Actions > Variables
# como *Variable* e nao Secret — o endereco e publico e, sendo variavel,
# aparece nos registos, o que ajuda a perceber falhas.
API_HEALTH_URL=https://o-teu-servico.onrender.com/actuator/health
